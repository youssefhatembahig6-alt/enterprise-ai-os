# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# Node
node_modules/
apps/web/dist/
apps/web/.next/
apps/web/next-env.d.ts
apps/web/test-results/
apps/web/playwright-report/
packages/*/dist/
*.tsbuildinfo

# Environment — never commit real values (FR-006)
.env
.env.*
!.env.example
!infrastructure/.env.example

# Model weights — never committed, never redistributed (FR-011g, docs/models.md).
# Both licences are recorded there; the Qwen one permits redistribution only with the
# agreement attached, which a git repository does not do on its own.
#
# `/models/` is anchored to the repository root deliberately. An unanchored `models/`
# matches at every depth, which would silently swallow new files under
# packages/core/src/eaios_core/models/ — the ORM package, nothing to do with weights.
/models/
*.gguf
*.safetensors
*.bin

# Docker volumes / local state
infrastructure/.volumes/

# Generated API client is committed deliberately; generated seed output is not
scripts/seed/.out/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.tmp
*.log
