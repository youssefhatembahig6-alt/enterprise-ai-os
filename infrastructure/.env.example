# Copy to .env at the repo root:  cp infrastructure/.env.example .env
# Every value here is a non-production placeholder. No real secret is ever
# committed (spec FR-006), and these defaults work out of the box so a newcomer
# needs no hand-editing to start the system (spec FR-005, SC-001).

# --- Environment ------------------------------------------------------------
# Anything other than "local" makes `eaios-seed reset` refuse to run, regardless
# of --yes. That is the outer guard on the only destructive command.
ENVIRONMENT=local
LOG_LEVEL=info
LOG_JSON=true

# Pinned so number and date formatting cannot vary by host (spec FR-012a).
TZ=UTC
LANG=C.UTF-8

# --- PostgreSQL -------------------------------------------------------------
# Two roles by design (research R6):
#   eaios_owner — owns the schema, runs migrations and the seed, bypasses RLS
#   eaios_app   — used by the API and worker, RLS enforced
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=eaios
POSTGRES_OWNER_USER=eaios_owner
POSTGRES_OWNER_PASSWORD=eaios_owner_local_only
POSTGRES_APP_USER=eaios_app
POSTGRES_APP_PASSWORD=eaios_app_local_only

# Host port, changed only if something else already listens on 5432.
POSTGRES_HOST_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_HOST_PORT=6379

# --- Qdrant -----------------------------------------------------------------
# Provisioned with tenant-scoped structure but left empty in this feature
# (confirmed scope decision D2).
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_HOST_PORT=6333
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine

# --- MinIO (S3-compatible object storage) -----------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=eaios_local
MINIO_SECRET_KEY=eaios_local_only_secret
MINIO_BUCKET=eaios
MINIO_SECURE=false
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- Application ports ------------------------------------------------------
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# --- Proxy trust -------------------------------------------------------------
# Comma-separated hosts whose `X-Forwarded-For` the rate limiter believes.
#
# Browser traffic goes to the site's own origin and Next forwards it to the API,
# because direct cross-origin calls never worked — the API sends no CORS headers.
# Without this the per-address bounds would count the *proxy*, so five contact
# submissions an hour from anybody would exhaust the allowance for everybody.
#
# A header from any other host is ignored. Empty means trust nothing.
TRUSTED_PROXIES=web

# --- Authentication (feature 003) -------------------------------------------
# Local-only placeholders, exactly like the database passwords above. The signing
# key is symmetric because one process both mints and verifies (research R2).
AUTH_JWT_SIGNING_KEY=eaios_jwt_local_only_not_a_real_secret
AUTH_JWT_ISSUER=eaios-api
AUTH_JWT_AUDIENCE=eaios-portal

# Session bounds, in seconds (spec 003 FR-005). Both are required and they cover
# different risks: 30 minutes idle protects an unattended machine, 8 hours absolute
# limits how long a stolen credential stays useful. Activity renews the first and
# never the second.
AUTH_IDLE_TIMEOUT_SECONDS=1800
AUTH_ABSOLUTE_LIFETIME_SECONDS=28800

# Sign-in attempt bounds (FR-007a). Per account and per address, because either one
# alone is defeated — spreading attempts across addresses beats an address bound,
# and an account bound alone lets an attacker lock a real user out on purpose.
AUTH_LOGIN_ACCOUNT_MAX_FAILURES=5
AUTH_LOGIN_ADDRESS_MAX_FAILURES=20
AUTH_LOGIN_BOUND_WINDOW_SECONDS=900

# The demo credential written by `make credentials`, which refuses to run unless
# ENVIRONMENT=local. Synthetic users, no real person behind any account (FR-002a).
AUTH_DEMO_PASSWORD=eaios-demo-local-only

# --- Seed -------------------------------------------------------------------
# The committed default seed (spec FR-012c). Overriding it produces a different
# but equally valid dataset — and invalidates the committed fingerprint.
EAIOS_SEED=20260630
EAIOS_REFERENCE_DATE=2026-06-30
EAIOS_PROFILE=full
