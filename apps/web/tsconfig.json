{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `preserve` hands JSX to the Next compiler rather than transforming it here.
    "jsx": "preserve",
    "noEmit": true,
    "declaration": false,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // `node` for server components reading process.env; vitest/globals supplies
    // describe/it/expect to component tests without importing them everywhere.
    "types": ["node", "vitest/globals"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "e2e"]
}
